{
  "name": "tune-into-her",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:generate": "node scripts/generate-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "locales:generate": "node scripts/build-ui-locales.mjs",
    "release:check": "node scripts/release-check.mjs",
    "eas-build-pre-install": "node scripts/eas-production-check.mjs",
    "content:check": "node scripts/generate-content.mjs --check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "latest",
    "expo": "~57.0.31",
    "expo-constants": "latest",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "latest",
    "expo-updates": "~57.0.26",
    "i18next": "latest",
    "react": "19.2.3",
    "react-i18next": "latest",
    "react-native": "0.86.3",
    "react-native-purchases": "latest",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-expo": "~57.0.2",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "react-dom": "19.2.3"
  }
}
