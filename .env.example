EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_USE_MOCK_BILLING=false

# Keep sandbox and production endpoints/databases separate. No secret belongs here.
EXPO_PUBLIC_BILLING_ENVIRONMENT=sandbox
EXPO_PUBLIC_TRIAL_API_URL=
# Actual rc-… URL scheme copied from RevenueCat Web Billing dashboard; rebuild native apps.
EXPO_PUBLIC_REVENUECAT_REDEMPTION_SCHEME=
# Optional explicit offering; empty uses RevenueCat current offering.
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=
